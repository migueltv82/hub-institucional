# Frontend/public Supabase config. Estas variables pueden ir al cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para scripts locales/backend. Nunca usar en frontend ni con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TEST_INSTITUTION_ID=
SUPABASE_TEST_WORKSPACE_KEY=main

VITE_DISABLE_AUTH=false
VITE_ENABLE_EXAM_ADMIN_REVIEW_WORKFLOW=false
VITE_ENABLE_EXAM_ENGINE_AUDIT=false
VITE_ENABLE_EXAM_ENGINE_PREVIEW=false
# Solo DEV con VITE_SUPABASE_URL apuntando a localhost/127.0.0.1.
VITE_ENABLE_STUDENT_COURSE_ENROLLMENT_INTERNAL_PREVIEW=false
VITE_ENABLE_TEACHER_COURSE_ROSTER_INTERNAL_PREVIEW=false
